{
  "name": "amigo-secreto-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "preview:local": "node scripts/preview-catalogue.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:db && npm run test:seed",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:ui": "playwright test",
    "test:db": "node scripts/test-database.mjs",
    "test:db:local": "node scripts/test-supabase-local.mjs",
    "test:seed": "node --test tests/database/*.test.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "participants:local": "node scripts/participants-local.mjs",
    "organizer:bootstrap": "node scripts/organizer-local.mjs",
    "functions:local": "supabase functions serve --env-file supabase/functions/.env.example",
    "test:access:concurrency": "node scripts/test-access-concurrency.mjs",
    "test:access:http": "node scripts/test-access-http.mjs",
    "test:mutations:http": "node scripts/test-mutations-http.mjs",
    "test:mutations:concurrency": "node scripts/test-mutations-concurrency.mjs",
    "test:media:http": "node scripts/test-media-http.mjs",
    "test:media:concurrency": "node scripts/test-media-concurrency.mjs",
    "test:media:ui:local": "node scripts/test-media-ui-local.mjs",
    "test:rates:concurrency": "node scripts/test-rate-limits-concurrency.mjs",
    "test:rates:http": "node scripts/test-rate-limits-http.mjs",
    "test:import:local": "node scripts/test-product-import-local.mjs",
    "test:import:concurrency": "node scripts/test-import-concurrency.mjs",
    "probe:edge:network": "node scripts/probe-edge-network.mjs",
    "fetch-proxy:local": "node --env-file=server/product-fetch/.env.local scripts/serve-product-fetch-local.mjs",
    "cleanup:local": "node scripts/cleanup-media-local.mjs",
    "cleanup:rates:local": "node scripts/cleanup-rate-limits-local.mjs",
    "vendor:images": "node scripts/vendor-image-codecs.mjs",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.12",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
