{
  "name": "amigo-secreto-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:db && npm run test:seed",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:db:local": "node scripts/test-supabase-local.mjs",
    "test:seed": "node --test tests/database/*.test.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "organizer:bootstrap": "node scripts/organizer-local.mjs",
    "functions:local": "supabase functions serve wishlist-api --env-file supabase/functions/.env.example",
    "test:access:concurrency": "node scripts/test-access-concurrency.mjs",
    "test:access:http": "node scripts/test-access-http.mjs",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
