# Configuración local de las cuatro Edge Functions. No contiene claves reales.
# Copiar a .env.local para personalizar; el comando functions:local usa este ejemplo.
# 5175 conserva compatibilidad con el ensayo local T14; nunca es un origen remoto.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5175
APP_BASE_URL=http://localhost:5173
# Leave off in local/unverified environments. All forwarded IP headers are ignored.
# Enable verified-cloudflare ONLY after verifying provider sanitization for every ingress route.
RATE_LIMIT_IP_SOURCE=off
# Solo servidor: 32 bytes base64url canónicos, igual en las Edge Functions con cuota por IP si se habilita.
# With IP_SOURCE=off this placeholder is unused; global/token limits remain active.
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
# T16: absent/placeholder config fails closed. No direct unpinned fetch fallback.
FETCH_PROXY_URL=
FETCH_PROXY_HMAC_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
# HTTP/host.docker.internal allowed ONLY by the isolated local test (never hosted Edge).
APP_LOCAL_FETCH_PROXY=0
# Asistente de «Otra consulta». 1 lo habilita; 0 lo apaga sin tocar catálogo ni edición.
GIFT_ASSISTANT_ENABLED=0
# synthetic: respuestas locales sin red ni coste (nunca en Edge alojado). Ausente o gemini: proveedor real.
GIFT_ASSISTANT_PROVIDER=synthetic
# Solo servidor y distinta por entorno. Nunca en VITE_*, Git ni chat.
GEMINI_API_KEY=REPLACE_WITH_SERVER_ONLY_GEMINI_KEY
# Modelo fijado por el servidor; vacío deja el proveedor gemini sin configurar.
GEMINI_MODEL=gemini-3.5-flash-lite
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta la CLI/Edge runtime.
# No duplicar credenciales aquí ni usar prefijo VITE_. No registrar sus valores.
# Preparación local, proxy firmado y configuración alojada pendiente: docs/environment.md.
