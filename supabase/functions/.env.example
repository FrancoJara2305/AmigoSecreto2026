# Configuración local de T07. No contiene claves reales.
# Copiar a .env.local para personalizar; el comando functions:local usa este ejemplo.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
# Reservado a futuras cuotas por IP de T15; T07 usa cuotas globales y por hash.
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta la CLI/Edge runtime.
# No duplicar credenciales aquí ni usar prefijo VITE_. No registrar sus valores.
