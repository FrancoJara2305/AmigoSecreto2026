# Solo configuración PÚBLICA de React/Vite. Copiar a .env.local sin sobrescribir uno existente.
# URL local al ejecutar Supabase con Docker. En remoto, usar la URL del Dashboard.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Reemplazar con la clave publishable o JWT anon del entorno elegido.
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
# Opcional: si se omite, el cliente usa el origen actual del navegador.
VITE_APP_URL=http://localhost:5173

# Nunca añadir service_role, sb_secret_, contraseñas de DB o tokens privados a VITE_*.
# Los secretos de Edge van en supabase/functions/.env.local (ignorado),
# separados de Vite. Ver supabase/functions/.env.example.
# Guía completa y orígenes/puertos: docs/environment.md. Sin sorteo ni cuentas Auth.
