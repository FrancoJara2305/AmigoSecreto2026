{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "api", "vite.config.ts", "playwright.config.ts", "playwright.a11y.config.ts", "playwright.reader.config.ts", "playwright.security.config.ts", "tests/unit", "tests/ui", "tests/a11y", "supabase/functions/_shared"]
}
