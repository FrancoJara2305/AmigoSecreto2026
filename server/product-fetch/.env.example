# SOLO SERVIDOR Node. Copiar sin sobrescribir .env.local existente.
# Mismo secreto aleatorio de 32 bytes base64url que FETCH_PROXY_HMAC_SECRET de Edge.
FETCH_PROXY_HMAC_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
FETCH_PROXY_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/product-metadata
# No Supabase service_role key or participant token belongs in this runtime.
# El callback anterior es SOLO local. En Vercel debe ser el endpoint HTTPS del entorno aprobado.
# Ver docs/environment.md; no se ha desplegado este adaptador.
